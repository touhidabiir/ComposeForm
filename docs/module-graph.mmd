---
config:
  layout: elk
---
%% Source for docs/module-graph.png, shown in README.md (Gradle module paths).
%% docs/architecture-diagram.mmd is the same graph in the architecture docx's own vocabulary.
%% `layout: elk` above is what gives the right-angle connectors - without it Mermaid's default
%% dagre layout draws curves. Needs Mermaid 11+ (e.g. the live editor); GitHub's built-in
%% Mermaid isn't guaranteed to honour it, which is why README.md embeds the rendered PNG. Regenerate with:
%%   npx -p @mermaid-js/mermaid-cli mmdc -i docs/module-graph.mmd -o docs/module-graph.png -s 2 -b white
flowchart TD
    app[":app"]

    subgraph features["feature/"]
        lead[":feature:leaddashboard"]
        acq[":feature:acquisition"]
    end

    common[":common"]
    ds[":designsystem"]
    fb[":formbuilder"]
    data[":data"]
    net[":network"]
    db[":database"]

    m3[["Material3"]]
    sq[["OkHttp / Retrofit"]]
    room[["Room"]]

    app --> lead & acq & common & ds & fb & data
    app -. config only .-> net
    lead & acq --> data & ds & common
    common --> ds
    fb --> ds
    data -- api --> net
    data --> db
    ds --> m3
    net --> sq
    db --> room

    classDef external fill:#eee,stroke:#999,color:#333
    class m3,sq,room external
