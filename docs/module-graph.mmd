%% Source for docs/module-graph.png, shown in README.md (Gradle module paths).
%% docs/architecture-diagram.mmd is the same graph in the architecture docx's own vocabulary.
%% `flowchart-elk` (not plain `flowchart`) is what gives the right-angle connectors - plain
%% `flowchart` uses the dagre layout, which draws curves. Preferred over a `layout: elk` config
%% block since editors that don't recognise that setting silently ignore it. README.md embeds
%% the rendered PNG rather than this source. Regenerate with:
%%   npx -p @mermaid-js/mermaid-cli mmdc -i docs/module-graph.mmd -o docs/module-graph.png -s 2 -b white
flowchart-elk TD
    app[":app"]

    subgraph features["feature/"]
        lead[":feature:leaddashboard"]
        acq[":feature:acquisition"]
    end

    common[":common"]
    ds[":designsystem"]
    fb[":formbuilder"]
    data[":data"]
    net[":network"]
    db[":database"]

    m3[["Material3"]]
    sq[["OkHttp / Retrofit"]]
    room[["Room"]]

    app --> lead & acq & common & ds & fb & data
    app -. config only .-> net
    lead & acq --> data & ds & common
    common --> ds
    fb --> ds
    data -- api --> net
    data --> db
    ds --> m3
    net --> sq
    db --> room

    classDef external fill:#eee,stroke:#999,color:#333
    class m3,sq,room external
