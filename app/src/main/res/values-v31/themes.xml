<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash before the first frame. Giving it the brand
         color makes it run straight into SplashScreen (the Compose one) instead of flashing white. -->
    <style name="Theme.ComposeForm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/brand_primary</item>
    </style>
</resources>
